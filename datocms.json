{
  "name": "Astro Starter Kit",
  "description": "A Astro project template powered by DatoCMS",
  "previewImage": "https://www.datocms-assets.com/205/1770110778-tech-starter-kit.png?w=600&auto=format",
  "datocmsProjectId": "186629",
  "deploymentType": "static",
  "buildCommand": "npm run build",
  "environmentVariables": {
    "DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CDA Only (Published)"
    },
    "DATOCMS_DRAFT_CONTENT_CDA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CDA Only (Draft)"
    },
    "DATOCMS_CMA_TOKEN": {
      "type": "datocmsAccessToken",
      "tokenName": "CMA Only (Read)"
    },
    "DATOCMS_BASE_EDITING_URL": {
      "type": "datocmsProjectUrl"
    },
    "SECRET_API_TOKEN": {
      "type": "secret",
      "format": "readable",
      "label": "Draft Mode password",
      "description": "You'll need it to turn on Draft Mode from the website."
    },
    "DRAFT_MODE_COOKIE_NAME": {
      "type": "string",
      "value": "__draftMode"
    },
    "SIGNED_COOKIE_JWT_SECRET": {
      "type": "secret"
    }
  },
  "livePreviewUrl": "https://datocms-astro-starter-kit.vercel.app/",
  "postDeploy": {
    "type": "apiCall",
    "url": "/api/post-deploy",
    "description": "Setting up the DatoCMS project..."
  }
}
