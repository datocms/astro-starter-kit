{
  "name": "astro-starter-kit",
  "type": "module",
  "version": "0.0.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "npx simple-git-hooks && npm run generate-schema && npm run generate-cma-types",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\" && gql.tada generate-output'",
    "generate-cma-types": "dotenv -c -- bash -c 'npx datocms schema:generate --api-token=$DATOCMS_CMA_TOKEN src/lib/datocms/cma-types.ts'",
    "lint": "prettier --check .",
    "format": "npx prettier . --write"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.1.0",
    "@astrojs/vercel": "^11.0.15",
    "@datocms/astro": "^0.6.16",
    "@datocms/cda-client": "^0.3.2",
    "@datocms/cma-client": "^6.8.0",
    "@mux/mux-player": "^3.14.0",
    "@mux/mux-player-react": "^3.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "datocms-plugin-sdk": "^2.5.0",
    "datocms-react-ui": "^2.5.1",
    "datocms-structured-text-generic-html-renderer": "^6.0.0",
    "datocms-structured-text-to-plain-text": "^6.0.0",
    "gql.tada": "^1.11.4",
    "jsonwebtoken": "^9.0.3",
    "node-html-parser": "^9.0.4",
    "react": "^19.3.1",
    "react-datocms": "^8.1.2",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "datocms": "^4.2.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run format"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    },
    "tty-table": {
      "csv": "^6.6.4"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true,
    "yarn@1.22.22": true
  }
}
